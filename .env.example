# Copie para .env e preencha (cp .env.example .env). Na Azure, crie as mesmas chaves em Configuração > Variáveis de ambiente.
PORT=5000
MARKET_SERVICE_URL=https://praticom-market.azurewebsites.net
FINANCE_SERVICE_URL=https://praticom-finance.azurewebsites.net
# Mesma chave configurada nos dois microsserviços.
INTERNAL_API_KEY=troque-esta-chave
# Origens liberadas no CORS (endereço do site estático), separadas por vírgula.
CORS_ORIGINS=https://praticomfrontxxxxxx.z1.web.core.windows.net,http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
